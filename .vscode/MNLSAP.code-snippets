{
	// MNLSAP code snippets for ABAP Development

	// ------------------ ABAP -------------------- //
	"Flowerbox New": {
		"scope": "abap",
    "prefix": "fbox-new",
    "body": [
      "*&---------------------------------------------------------------------*",
      "*& Report  ${1:ZREPORTNAME}                                            *",
      "*&---------------------------------------------------------------------*",
      "*& Purpose     : ${2:What it does} *",
      "*& Description : ${3:[ST000000]CODE - SCR Description} *",
      "*& Author      : ${4:First Name Last Name (DOMAIN)}                        *",
      "*& Date        : ${5:DD Mmm YYYY}                                          *",
      "*&---------------------------------------------------------------------*",
      "*& Revision    :                                                       *",
      "*&             :                                                       *",
      "*& Revised by  :                                                       *",
      "*& Revised on  :                                                       *",
      "*& Search Str  :                                                       *",
      "*&---------------------------------------------------------------------*",
      ""
    ],
    "description": "Flowerbox New snippet"
  },

	"Flowerbox Revision": {
    "scope": "abap",
    "prefix": "fbox-rev",
    "body": [
      "*& Revision    : ${1:Story/Task}  *",
      "*&             :                                   *",
      "*& Revised by  : ${2:Person Owner}                          *",
      "*& Revised on  : ${3:Date}                                           *",
      "*& Search Str  : ${4:Search String}                                            *",
      "*&---------------------------------------------------------------------*",
      "*& Revision    :                                                       *",
      "*&             :                                                       *",
      "*& Revised by  :                                                       *",
      "*& Revised on  :                                                       *",
      "*& Search Str  :                                                       *",
      "*&---------------------------------------------------------------------*",
      ""
    ],
    "description": "Flowerbox Revision snippet"
  },

		"New Program Template": {
    "scope": "abap",
    "prefix": "new-prog",
    "body": [
      "*&---------------------------------------------------------------------*",
      "*& Report  ${1:ZREPORTNAME}                                            *",
      "*&---------------------------------------------------------------------*",
      "*& Purpose     : ${2:What it does} *",
      "*& Description : ${3:[ST000000]CODE - SCR Description} *",
      "*& Author      : ${4:First Name Last Name (DOMAIN)}                        *",
      "*& Date        : ${5:DD Mmm YYYY}                                          *",
      "*&---------------------------------------------------------------------*",
      "*& Revision    :                                                       *",
      "*&             :                                                       *",
      "*& Revised by  :                                                       *",
      "*& Revised on  :                                                       *",
      "*& Search Str  :                                                       *",
      "*&---------------------------------------------------------------------*",
      "",
			"REPORT ${1:ZREPORTNAME}.",
      "\tLINE-SIZE 255",
    	"\tLINE-COUNT 60",
      "\tMESSAGE-ID zb",
      "\tNO STANDARD PAGE HEADING.",
			"",
			"*&---------------------------------------------------------------------*",
			"*&\t\tPARAMETERS                                                       *",
			"*&---------------------------------------------------------------------*",
			"SELECTION-SCREEN: BEGIN OF BLOCK b1   WITH FRAME TITLE text-001.",
			"PARAMETERS      : p_param1            TYPE c LENGTH 10.",
			"SELECTION-SCREEN: END OF BLOCK b1.",
			"",
			"*&---------------------------------------------------------------------*",
			"*&\t\tGLOBAL VARIABLES                                                 *",
			"*&---------------------------------------------------------------------*",
			"TYPES:",
			"\tBEGIN OF gty_variable1_type",
			"\t\tdummy                             TYPE c LENGTH 10.",
			"\tEND OF gty_variable1_type.",
			"",
			"DATA:" ,
			"\tgv_variable1                        TYPE c LENGTH 10.",  
			"",
			"CONSTANTS:",
			"\tgc_variable1                        TYPE c LENGTH 10 VALUE 'X'.",
			"",
			"*&---------------------------------------------------------------------*",
			"*&\t\tSTART-OF-SELECTION                                               *",
			"*&---------------------------------------------------------------------*",
			"START-OF-SELECTION."
    ],
    "description": "New Program snippet"
  },

